# Neon CLI fills these after neon init / neon deploy. All values are server-only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# App-managed secret: generate locally with openssl rand -base64 32.
NEON_AUTH_COOKIE_SECRET=

# Local first-administrator setup only; no password is stored here.
PROOMAHAN_BOOTSTRAP_NAME=
PROOMAHAN_BOOTSTRAP_PHONE=
